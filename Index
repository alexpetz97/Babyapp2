<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Alex & Marcelina's Babyname</title>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #fdf8f6; }
    h1, h2, h3, .font-fun { font-family: 'Fredoka', cursive; }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    const NAMES = [
      { name: 'Liam', gender: 'boy', origin: 'Altdeutsch / Irisch', meaning: 'Entschlossener Beschützer' },
      { name: 'Emma', gender: 'girl', origin: 'Altdeutsch', meaning: 'Die Allumfassende' },
      { name: 'Noah', gender: 'boy', origin: 'Hebräisch', meaning: 'Der Tröstende' },
      { name: 'Mia', gender: 'girl', origin: 'Skandinavisch', meaning: 'Die Geliebte' },
      { name: 'Oliver', gender: 'boy', origin: 'Lateinisch', meaning: 'Der Olivenbaum-Pflanzer' },
      { name: 'Olivia', gender: 'girl', origin: 'Lateinisch', meaning: 'Die Olivenzweig-Trägerin' },
      { name: 'Mateo', gender: 'boy', origin: 'Spanisch', meaning: 'Gabe Gottes' },
      { name: 'Sophia', gender: 'girl', origin: 'Griechisch', meaning: 'Die göttliche Weisheit' },
      { name: 'Lucas', gender: 'boy', origin: 'Griechisch', meaning: 'Der Ins Licht Geborene' },
      { name: 'Charlotte', gender: 'girl', origin: 'Französisch', meaning: 'Die Freie' },
      { name: 'Leo', gender: 'boy', origin: 'Lateinisch', meaning: 'Der Löwe' },
      { name: 'Ella', gender: 'girl', origin: 'Altdeutsch', meaning: 'Die Strahlende' }
    ];

    function BabyNameApp() {
      const [currentUser, setCurrentUser] = useState('Alex');
      const [lastName, setLastName] = useState('Müller');
      const [currentIndex, setCurrentIndex] = useState(0);
      const [userLikes, setUserLikes] = useState({ Alex: [], Marcelina: [] });
      const [userDislikes, setUserDislikes] = useState({ Alex: [], Marcelina: [] });
      const [activeTab, setActiveTab] = useState('swipe');
      const [showMatchModal, setShowMatchModal] = useState(null);

      const currentName = NAMES[currentIndex];

      const handleSwipe = (direction) => {
        if (!currentName) return;
        const name = currentName.name;

        if (direction === 'like') {
          const updatedLikes = { ...userLikes, [currentUser]: [...userLikes[currentUser], name] };
          setUserLikes(updatedLikes);

          const otherUser = currentUser === 'Alex' ? 'Marcelina' : 'Alex';
          if (updatedLikes[otherUser].includes(name)) {
            setShowMatchModal(name);
          }
        } else {
          setUserDislikes({ ...userDislikes, [currentUser]: [...userDislikes[currentUser], name] });
        }

        setCurrentIndex(prev => prev + 1);
      };

      const matches = NAMES.filter(n => userLikes.Alex.includes(n.name) && userLikes.Marcelina.includes(n.name));

      return (
        <div className="max-w-md mx-auto min-h-screen pb-10 px-4 pt-4 flex flex-col">
          <div className="bg-white rounded-3xl p-4 shadow-sm mb-4 border border-rose-100 flex justify-between items-center">
            <div>
              <h1 className="text-xl font-bold text-rose-500">Alex & Marcelina</h1>
              <p className="text-xs text-gray-400">Babyname-Finder</p>
            </div>
            <div className="flex bg-rose-50 p-1 rounded-2xl border border-rose-100">
              <button 
                onClick={() => setCurrentUser('Alex')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition ${currentUser === 'Alex' ? 'bg-rose-500 text-white shadow-sm' : 'text-gray-500'}`}>
                Alex
              </button>
              <button 
                onClick={() => setCurrentUser('Marcelina')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition ${currentUser === 'Marcelina' ? 'bg-purple-500 text-white shadow-sm' : 'text-gray-500'}`}>
                Marcelina
              </button>
            </div>
          </div>

          <div className="bg-white rounded-2xl p-3 shadow-sm mb-4 border border-rose-100">
            <label className="text-xs text-gray-400 font-semibold block mb-1">Euer Nachname:</label>
            <input 
              type="text" 
              value={lastName} 
              onChange={(e) => setLastName(e.target.value)}
              className="w-full bg-rose-50/50 rounded-xl px-3 py-2 text-sm font-bold text-gray-700 outline-none border border-rose-100"
              placeholder="Nachname eingeben..."
            />
          </div>

          <div className="flex bg-white rounded-2xl p-1 shadow-sm mb-4 border border-rose-100">
            <button onClick={() => setActiveTab('swipe')} className={`flex-1 py-2 text-xs font-bold rounded-xl ${activeTab === 'swipe' ? 'bg-rose-100 text-rose-600' : 'text-gray-400'}`}>Swipen</button>
            <button onClick={() => setActiveTab('matches')} className={`flex-1 py-2 text-xs font-bold rounded-xl ${activeTab === 'matches' ? 'bg-rose-100 text-rose-600' : 'text-gray-400'}`}>Matches ({matches.length})</button>
          </div>

          {activeTab === 'swipe' && (
            <div className="flex-1 flex flex-col justify-center items-center">
              {currentName ? (
                <div className="w-full bg-white rounded-3xl p-8 shadow-xl border border-rose-100 text-center relative overflow-hidden">
                  <span className={`inline-block px-3 py-1 rounded-full text-xs font-bold mb-4 ${currentName.gender === 'boy' ? 'bg-blue-100 text-blue-600' : 'bg-pink-100 text-pink-600'}`}>
                    {currentName.gender === 'boy' ? 'Junge' : 'Mädchen'}
                  </span>
                  
                  <div className="my-6">
                    <h2 className="text-4xl font-extrabold text-gray-800 tracking-wide">{currentName.name}</h2>
                    <p className="text-2xl font-bold text-rose-400 mt-1">{lastName}</p>
                  </div>

                  <div className="bg-rose-50/50 rounded-2xl p-4 text-xs text-gray-600 space-y-1">
                    <p><strong>Herkunft:</strong> {currentName.origin}</p>
                    <p><strong>Bedeutung:</strong> {currentName.meaning}</p>
                  </div>

                  <div className="flex justify-center gap-6 mt-8">
                    <button onClick={() => handleisch('dislike')} onClick={() => handleSwipe('dislike')} className="w-16 h-16 rounded-full bg-gray-100 text-gray-400 text-2xl flex items-center justify-center shadow-md active:scale-95 transition">✕</button>
                    <button onClick={() => handleSwipe('like')} className="w-16 h-16 rounded-full bg-rose-500 text-white text-2xl flex items-center justify-center shadow-lg active:scale-95 transition">♥</button>
                  </div>
                </div>
              ) : (
                <div className="text-center py-12 bg-white rounded-3xl p-6 shadow-sm border border-rose-100">
                  <p className="text-lg font-bold text-gray-700">Alle Namen durchgesehen! 🎉</p>
                  <button onClick={() => setCurrentIndex(0)} className="mt-4 px-4 py-2 bg-rose-500 text-white rounded-xl font-bold text-xs">Neustarten</button>
                </div>
              )}
            </div>
          )}

          {activeTab === 'matches' && (
            <div className="space-y-3">
              {matches.length === 0 ? (
                <div className="bg-white rounded-2xl p-6 text-center text-gray-400 text-xs">Nichts zu sehen... Swipt weiter für erste Matches! ❤️</div>
              ) : (
                matches.map((m, i) => (
                  <div key={i} className="bg-white rounded-2xl p-4 shadow-sm border border-rose-100 flex justify-between items-center">
                    <div>
                      <h3 className="font-bold text-base text-gray-800">{m.name} <span className="text-rose-400">{lastName}</span></h3>
                      <p className="text-xs text-gray-400">{m.meaning}</p>
                    </div>
                    <span className="text-xl">🎉</span>
                  </div>
                ))
              )}
            </div>
          )}

          {showMatchModal && (
            <div className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
              <div className="bg-white rounded-3xl p-6 text-center max-w-xs w-full shadow-2xl border-4 border-rose-300">
                <div className="text-5xl mb-2">💖</div>
                <h2 className="text-2xl font-bold text-rose-500">MATCH!</h2>
                <p className="text-sm text-gray-600 mt-2">Ihr liebt beide den Namen:</p>
                <p className="text-2xl font-black text-gray-800 mt-1">{showMatchModal} {lastName}</p>
                <button onClick={() => setShowMatchModal(name => null)} className="mt-6 w-full py-3 bg-rose-500 text-white font-bold rounded-2xl shadow-lg">Super!</button>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<BabyNameApp />);
  </script>
</body>
</html>
